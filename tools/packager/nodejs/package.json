{
  "name": "wa-kitchen",
  "description": "WhatsApp Web Protocol Buffers",
  "version": "0.0.0",
  "private": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./utils": {
      "types": "./utils.d.ts",
      "default": "./utils.js"
    },
    "./graphql": {
      "types": "./graphql/index.d.ts",
      "default": "./graphql/index.js"
    },
    "./proto/*": {
      "types": "./proto/*_pb.d.ts",
      "default": "./proto/*_pb.js"
    },
    "./binary/*": {
      "types": "./binary/*.d.ts",
      "default": "./binary/*.js"
    },
    "./chat/*": {
      "types": "./chat/*.d.ts",
      "default": "./chat/*.js"
    },
    "./group/*": {
      "types": "./group/*.d.ts",
      "default": "./group/*.js"
    },
    "./jid/*": {
      "types": "./jid/*.d.ts",
      "default": "./jid/*.js"
    },
    "./media/*": {
      "types": "./media/*.d.ts",
      "default": "./media/*.js"
    },
    "./message/*": {
      "types": "./message/*.d.ts",
      "default": "./message/*.js"
    },
    "./newsletter/*": {
      "types": "./newsletter/*.d.ts",
      "default": "./newsletter/*.js"
    },
    "./privacy/*": {
      "types": "./privacy/*.d.ts",
      "default": "./privacy/*.js"
    },
    "./stanza/*": {
      "types": "./stanza/*.d.ts",
      "default": "./stanza/*.js"
    }
  },
  "engines": {
    "node": ">=16.13.2"
  },
  "keywords": [
    "whatsapp",
    "protobuf",
    "graphql",
    "typescript"
  ],
  "license": "MIT",
  "author": "João Vitor Machado <joaov@zapctl.dev>",
  "homepage": "https://github.com/zapctl/wa-kitchen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zapctl/wa-kitchen.git"
  },
  "bugs": {
    "url": "https://github.com/zapctl/wa-kitchen/issues"
  },
  "dependencies": {
    "@bufbuild/protobuf": "1.10.0",
    "curve25519-js": "^0.0.4"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "1.10.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "uglify-js": "^3.19.3"
  }
}