{
  "type": "node",
  "namespace": "BizCtwaAction",
  "variant": "BannerSuggestionRequest",
  "tag": "notification",
  "attributes": {
    "from": {
      "type": "jid",
      "jidTypes": [
        "DomainJid"
      ]
    },
    "to": {
      "optional": true,
      "type": "jid",
      "jidTypes": [
        "UserJid"
      ]
    },
    "type": {
      "type": "string",
      "literal": "business"
    },
    "t": {
      "type": "number",
      "as": "string",
      "min": 0
    },
    "id": {
      "type": "id"
    },
    "offline": {
      "optional": true,
      "type": "number",
      "as": "string",
      "min": 0,
      "max": 1024
    }
  },
  "content": [
    {
      "type": "node",
      "tag": "ctwa_suggestion",
      "attributes": {
        "target_entity_id": {
          "type": "string"
        }
      },
      "content": [
        {
          "type": "node",
          "namespace": "BizCtwaAction",
          "variant": "NativeActionsMixin",
          "tag": "banner",
          "content": [
            {
              "type": "node",
              "tag": "config",
              "attributes": {
                "expires_at": {
                  "type": "number",
                  "as": "string",
                  "min": 1
                },
                "display": {
                  "type": "string",
                  "enum": [
                    "info",
                    "warning"
                  ]
                },
                "revoked": {
                  "type": "string",
                  "enum": [
                    "false",
                    "true"
                  ]
                }
              }
            },
            {
              "type": "node",
              "tag": "content",
              "attributes": {
                "locale": {
                  "type": "string"
                }
              },
              "content": [
                {
                  "type": "node",
                  "tag": "heading",
                  "content": {
                    "type": "string",
                    "as": "binary"
                  }
                },
                {
                  "type": "node",
                  "tag": "body",
                  "content": {
                    "type": "string",
                    "as": "binary"
                  }
                },
                {
                  "type": "node",
                  "tag": "highlight",
                  "content": {
                    "type": "string",
                    "as": "binary"
                  }
                },
                {
                  "type": "node",
                  "tag": "localised_heading",
                  "attributes": {
                    "value": {
                      "type": "string"
                    }
                  },
                  "content": [
                    {
                      "$ref": "BizCtwaAction:LocalisationMetadata"
                    }
                  ]
                },
                {
                  "type": "node",
                  "tag": "localised_body",
                  "attributes": {
                    "value": {
                      "type": "string"
                    }
                  },
                  "content": [
                    {
                      "$ref": "BizCtwaAction:LocalisationMetadata"
                    }
                  ]
                },
                {
                  "type": "node",
                  "tag": "localised_highlight",
                  "attributes": {
                    "value": {
                      "type": "string"
                    }
                  },
                  "content": [
                    {
                      "$ref": "BizCtwaAction:LocalisationMetadata"
                    }
                  ]
                }
              ]
            },
            {
              "type": "node",
              "tag": "action",
              "attributes": {
                "deep_link": {
                  "optional": true,
                  "type": "string"
                },
                "local_link": {
                  "optional": true,
                  "type": "string"
                },
                "local_android_link": {
                  "optional": true,
                  "type": "string"
                }
              }
            },
            {
              "type": "node",
              "tag": "native_action",
              "attributes": {
                "platform": {
                  "type": "string"
                },
                "min_app_version": {
                  "type": "string"
                },
                "local_link": {
                  "type": "string"
                },
                "universal_link": {
                  "optional": true,
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}